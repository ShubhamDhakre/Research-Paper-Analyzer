# ==============================================================================
# AI Research Paper Analyzer & Research Assistant - Environment Configuration
# ==============================================================================

# --- Node.js Backend Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Frontend (Vite) ---
# Note: Vite only exposes variables prefixed with VITE_ to the browser client.
VITE_API_BASE_URL=http://localhost:5000/api

# --- Database & Security ---
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/research_paper_analyzer

# JWT Secret Key for signing user authentication tokens (Must be at least 32 characters)
# Generate a strong key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_for_security

# --- AI & LLM Provider Configuration ---
# Supported providers: gemini, openai, anthropic, or ollama (local)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Python AI Microservice ---
PYTHON_SERVICE_URL=http://localhost:8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
MAX_PDF_SIZE_MB=20
